FROM node:24-alpine
WORKDIR /app
COPY package.json package-lock.json ./
COPY services/products/package.json services/products/package.json
COPY services/auth/package.json services/auth/package.json
COPY services/orders/package.json services/orders/package.json
RUN npm ci --omit=dev
COPY scripts/verify-inventory-flow.cjs scripts/verify-inventory-flow.cjs
USER node
CMD ["node", "scripts/verify-inventory-flow.cjs"]
