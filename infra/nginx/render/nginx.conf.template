events {}

http {
  # Repassa o X-Request-Id do cliente quando ele tem formato seguro; caso
  # contrário (ausente, vazio, longo ou com caracteres especiais) gera um novo.
  map $http_x_request_id $gateway_request_id {
    "~^[A-Za-z0-9._:-]{1,128}$" $http_x_request_id;
    default $request_id;
  }

  # Caminho incluído nos erros JSON do gateway somente quando não puder
  # quebrar o documento.
  map $uri $gateway_error_path {
    "~^[A-Za-z0-9/._~:-]*$" $uri;
    default "";
  }

  map $time_iso8601 $gateway_timestamp {
    "~^(?<gateway_utc_time>.+)\+00:00$" "${gateway_utc_time}Z";
    default $time_iso8601;
  }

  log_format gateway '$remote_addr - [$time_local] "$request" $status '
                     '$body_bytes_sent "$http_user_agent" '
                     'request_id=$gateway_request_id upstream=$upstream_addr';
  access_log /var/log/nginx/access.log gateway;

  upstream auth_service {
    server ${AUTH_HOST}:443;
  }

  upstream products_service {
    server ${PRODUCTS_HOST}:443;
  }

  upstream inventory_service {
    server ${INVENTORY_HOST}:443;
  }

  upstream orders_service {
    server ${ORDERS_HOST}:443;
  }

  map $proxy_host $cloud_host {
    auth_service ${AUTH_HOST};
    products_service ${PRODUCTS_HOST};
    inventory_service ${INVENTORY_HOST};
    orders_service ${ORDERS_HOST};
  }

  server {
    listen ${PORT};
    server_name _;

    proxy_set_header Host $cloud_host;
    proxy_ssl_name $cloud_host;
    proxy_ssl_server_name on;
    proxy_ssl_verify on;
    proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
    proxy_ssl_verify_depth 3;
    proxy_connect_timeout 15s;
    proxy_read_timeout 90s;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Authorization $http_authorization;
    proxy_set_header X-Request-Id $gateway_request_id;
    # O token interno nunca é aceito de clientes externos.
    proxy_set_header X-Internal-Token "";

    proxy_hide_header X-Request-Id;
    add_header X-Request-Id $gateway_request_id always;

    # Somente erros gerados pelo próprio Nginx (sem proxy_intercept_errors):
    # respostas de erro dos serviços são repassadas sem alteração.
    error_page 404 = @route_not_found;
    error_page 405 = @method_not_allowed;
    error_page 502 503 504 = @upstream_unavailable;

    location ^~ /api/v1/auth/ {
      proxy_pass https://auth_service;
    }

    location = /auth/docs { proxy_pass https://auth_service/docs; }
    location ^~ /auth/docs/ { proxy_pass https://auth_service/docs/; }
    location = /auth/docs-json { proxy_pass https://auth_service/docs-json; }

    location = /api/v1/products {
      proxy_pass https://products_service;
    }

    location = /api/v1/products/version {
      proxy_pass https://products_service;
    }

    # /api/v1/products/:id existe somente para a edição (PUT).
    location ^~ /api/v1/products/ {
      if ($request_method != PUT) {
        return 405;
      }
      proxy_pass https://products_service;
    }

    location = /api/v1/inventory { proxy_pass https://inventory_service; }
    location ^~ /api/v1/inventory/ { proxy_pass https://inventory_service; }
    location = /inventory/docs { proxy_pass https://inventory_service/docs; }
    location ^~ /inventory/docs/ { proxy_pass https://inventory_service/docs/; }
    location ^~ /inventory/swagger-ui/ { proxy_pass https://inventory_service/swagger-ui/; }
    location = /inventory/docs-json { proxy_pass https://inventory_service/docs-json; }

    location = /api/v1/orders { proxy_pass https://orders_service; }
    location ^~ /api/v1/orders/ { proxy_pass https://orders_service; }
    location = /orders/docs { proxy_pass https://orders_service/docs; }
    location ^~ /orders/docs/ { proxy_pass https://orders_service/docs/; }
    location = /orders/docs-json { proxy_pass https://orders_service/docs-json; }

    location = /docs {
      proxy_pass https://products_service;
    }

    location ^~ /docs/ {
      proxy_pass https://products_service;
    }

    location = /docs-json {
      proxy_pass https://products_service;
    }

    location = /health { return 200 "ok\n"; }

    location ^~ /internal/ {
      return 404;
    }

    location / {
      return 404;
    }

    location @route_not_found {
      default_type application/json;
      charset utf-8;
      charset_types application/json;
      return 404 '{"status":404,"code":"ROUTE_NOT_FOUND","message":"Rota não encontrada","path":"$gateway_error_path","traceId":"$gateway_request_id","timestamp":"$gateway_timestamp"}\n';
    }

    location @method_not_allowed {
      default_type application/json;
      charset utf-8;
      charset_types application/json;
      add_header Allow PUT always;
      add_header X-Request-Id $gateway_request_id always;
      return 405 '{"status":405,"code":"METHOD_NOT_ALLOWED","message":"Método não permitido para esta rota","path":"$gateway_error_path","traceId":"$gateway_request_id","timestamp":"$gateway_timestamp"}\n';
    }

    location @upstream_unavailable {
      default_type application/json;
      charset utf-8;
      charset_types application/json;
      return 503 '{"status":503,"code":"SERVICE_UNAVAILABLE","message":"Serviço temporariamente indisponível","path":"$gateway_error_path","traceId":"$gateway_request_id","timestamp":"$gateway_timestamp"}\n';
    }
  }
}
