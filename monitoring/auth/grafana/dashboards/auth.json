{
  "uid": "auth-delivery",
  "title": "Auth — DEV e HOMOL",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "environment",
        "type": "custom",
        "query": "dev,homol",
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Coleta disponível",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "auth-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"auth-.*\",environment=~\"$environment\"}",
          "legendFormat": "{{environment}}",
          "instant": false,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 2,
      "title": "Requisições por segundo",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "auth-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (environment) (rate(http_requests_total{environment=~\"$environment\"}[5m]))",
          "legendFormat": "{{environment}}",
          "instant": false,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 3,
      "title": "Latência p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "auth-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, environment) (rate(http_request_duration_seconds_bucket{environment=~\"$environment\"}[5m])))",
          "legendFormat": "{{environment}}",
          "instant": false,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 4,
      "title": "Erros HTTP 5xx",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "auth-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (environment) (rate(http_requests_total{status=~\"5..\",environment=~\"$environment\"}[5m])) or on (environment) (0 * max by (environment) (up{job=~\"auth-(dev|homol)\",environment=~\"$environment\"} == 1))",
          "legendFormat": "{{environment}}",
          "instant": false,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 5,
      "title": "Memória do processo",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "auth-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes{environment=~\"$environment\"}",
          "legendFormat": "{{environment}}",
          "instant": false,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 6,
      "title": "CPU em segundos por segundo",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "auth-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(process_cpu_seconds_total{environment=~\"$environment\"}[5m])",
          "legendFormat": "{{environment}}",
          "instant": false,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 7,
      "title": "Versão implantada",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "auth-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "auth_build_info{environment=~\"$environment\"}",
          "legendFormat": "{{environment}}",
          "instant": true,
          "format": "table"
        }
      ]
    },
    {
      "id": 8,
      "title": "Cadastros e logins por status",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "auth-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (environment, route, status) (rate(http_requests_total{environment=~\"$environment\",route=~\"/api/v1/auth/(login|register)\"}[5m]))",
          "legendFormat": "{{environment}} {{route}} {{status}}",
          "instant": false,
          "format": "time_series"
        }
      ]
    }
  ]
}
