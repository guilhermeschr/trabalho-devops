{
  "name": "trabalho-devops",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema de delivery com microsserviços",
  "workspaces": [
    "services/products"
  ],
  "scripts": {
    "build:products": "npm --workspace services/products run build",
    "dev:products": "npm --workspace services/products run start:dev",
    "typecheck": "npm run typecheck --workspaces",
    "test:products": "npm --workspace services/products run test:cov --",
    "verify:swagger:products": "node scripts/verify-products-swagger.mjs",
    "infra:config": "docker compose --env-file .env -f infra/docker/docker-compose.yml config",
    "infra:up": "docker compose --env-file .env -f infra/docker/docker-compose.yml up --build --force-recreate",
    "infra:down": "docker compose --env-file .env -f infra/docker/docker-compose.yml down",
    "build:inventory": "mvn -f services/inventory/pom.xml -DskipTests package",
    "dev:inventory": "mvn -f services/inventory/pom.xml spring-boot:run",
    "test:inventory": "mvn -f services/inventory/pom.xml verify",
    "verify:swagger:inventory": "node scripts/verify-inventory-swagger.mjs",
    "verify:flow:inventory": "docker compose --env-file .env -f infra/docker/docker-compose.yml --profile tools run --rm inventory-check"
  }
}
